{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/splunk/token-meter/.agents/workflow/handoff.schema.json",
  "title": "Token Meter agent-workflow handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work_item_id",
    "state",
    "owner_role",
    "objective",
    "acceptance_criteria",
    "scope",
    "repository",
    "base_commit",
    "head_commit",
    "changed_files",
    "evidence",
    "findings",
    "unverified",
    "approvals"
  ],
  "properties": {
    "work_item_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "links": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "format": "uri", "maxLength": 2000}
    },
    "state": {
      "enum": [
        "intake",
        "accepted",
        "developing",
        "verifying-and-reviewing",
        "fix-required",
        "ready-to-merge",
        "closed",
        "blocked"
      ]
    },
    "owner_role": {
      "enum": ["coordinator", "developer", "tester", "reviewer", "communication-manager", "github-operator", "human-owner"]
    },
    "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in", "out"],
      "properties": {
        "in": {"type": "array", "items": {"type": "string", "maxLength": 1000}},
        "out": {"type": "array", "items": {"type": "string", "maxLength": 1000}}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "worktree", "branch"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "worktree": {"type": "string", "minLength": 1, "maxLength": 2000},
        "branch": {"type": ["string", "null"], "maxLength": 500}
      }
    },
    "base_commit": {"type": ["string", "null"], "maxLength": 64},
    "head_commit": {"type": ["string", "null"], "maxLength": 64},
    "changed_files": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "owner", "reason"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 2000},
          "owner": {"type": "string", "minLength": 1, "maxLength": 200},
          "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "status", "result", "head_commit"],
        "properties": {
          "check": {"type": "string", "minLength": 1, "maxLength": 1000},
          "command": {"type": ["string", "null"], "maxLength": 4000},
          "status": {"enum": ["passed", "failed", "not-run", "blocked"]},
          "result": {"type": "string", "maxLength": 4000},
          "head_commit": {"type": ["string", "null"], "maxLength": 64}
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "summary", "evidence", "owner", "disposition"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 200},
          "severity": {"enum": ["blocking", "important", "minor"]},
          "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 4000},
          "owner": {"type": ["string", "null"], "maxLength": 200},
          "disposition": {"enum": ["open", "fixed", "disproved", "accepted-by-owner", "externally-blocked"]}
        }
      }
    },
    "unverified": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "blockers": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "approvals": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "scope", "granted_by"],
        "properties": {
          "action": {"type": "string", "minLength": 1, "maxLength": 500},
          "scope": {"type": "string", "minLength": 1, "maxLength": 2000},
          "granted_by": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  }
}
