#!/usr/bin/env bash
# Assemble the dashboard from dashboard/ parts and parse its inline JavaScript.
# Prints one line on success; on failure prints Node's parse error.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
page="$(mktemp "${TMPDIR:-/tmp}/token-meter-page.XXXXXX")"
trap 'rm -f "$page"' EXIT

PYTHONPATH="$ROOT" python3 -m token_meter.dashboard_page "$page"
node -e "const fs=require('fs');const h=fs.readFileSync(process.argv[1],'utf8');const m=h.match(/<script>([\s\S]*)<\/script>/);new Function(m[1]);console.log('js ok')" "$page"
