#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ROOT_URL="http://127.0.0.1:8722/"
HEALTH_URL="http://127.0.0.1:8722/health"
LOG="$ROOT/meter.log"
READINESS_TIMEOUT_SECONDS="${TOKEN_METER_READINESS_TIMEOUT_SECONDS:-600}"

if [[ ! -f "$ROOT/dashboard/page.manifest" ]]; then
  echo "Missing dashboard UI: $ROOT/dashboard/page.manifest" >&2
  echo "Run from a full token-meter clone that includes the dashboard folder." >&2
  exit 1
fi

if [[ ! "$READINESS_TIMEOUT_SECONDS" =~ ^[0-9]+$ || "$READINESS_TIMEOUT_SECONDS" -lt 1 ]]; then
  echo "TOKEN_METER_READINESS_TIMEOUT_SECONDS must be a positive whole number." >&2
  exit 1
fi

page_body="$(curl -s --max-time 2 "$ROOT_URL" 2>/dev/null || true)"
if [[ "$page_body" == *"page.html not found next to meter.py"* || "$page_body" == *"page.html is missing"* || "$page_body" == *"The dashboard files are missing"* ]]; then
  echo "A stale Token Meter server is already running without its dashboard files." >&2
  echo "Stop the listener on port 8722, then rerun: $ROOT/scripts/start-token-meter" >&2
  echo "Find it with: lsof -nP -iTCP:8722 -sTCP:LISTEN" >&2
  echo "Then stop that PID with: kill <PID>" >&2
  exit 1
fi

health_json="$(curl -fsS --max-time 5 "$HEALTH_URL" 2>/dev/null || true)"
if [[ "$health_json" != *'"ok": true'* ]]; then
  nohup python3 "$ROOT/meter.py" >> "$LOG" 2>&1 &
fi

readiness_deadline=$((SECONDS + READINESS_TIMEOUT_SECONDS))
while (( SECONDS < readiness_deadline )); do
  health_json="$(curl -fsS --max-time 5 "$HEALTH_URL" 2>/dev/null || true)"
  if [[ "$health_json" == *'"ok": true'* && "$health_json" == *'"state_ready": true'* ]]; then
    break
  fi
  sleep 1
done
if [[ "$health_json" != *'"ok": true'* || "$health_json" != *'"state_ready": true'* ]]; then
  echo "Token Meter did not finish indexing within ${READINESS_TIMEOUT_SECONDS}s at $HEALTH_URL" >&2
  if [[ -f "$LOG" ]]; then
    tail -n 20 "$LOG" >&2
  fi
  exit 1
fi

exec "$ROOT/scripts/run-menubar"
