#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MODE="${1:-all}"
SERVER_LABEL="com.token-meter.server"
MENUBAR_LABEL="com.token-meter.menubar"
LAUNCH_AGENTS_DIR="$HOME/Library/LaunchAgents"
SERVER_PLIST="$LAUNCH_AGENTS_DIR/$SERVER_LABEL.plist"
MENUBAR_PLIST="$LAUNCH_AGENTS_DIR/$MENUBAR_LABEL.plist"
PYTHON_BIN="$(command -v python3 || true)"
SERVER_PROGRAM="$ROOT/meter.py"
MENUBAR_PROGRAM="$ROOT/scripts/run-menubar"

case "$MODE" in
  all|server-only|menubar-only|backend-only) ;;
  *)
    echo "Usage: $0 [all|server-only|menubar-only|backend-only]" >&2
    exit 2
    ;;
esac

if [[ -z "$PYTHON_BIN" || ! -x "$PYTHON_BIN" ]]; then
  echo "Missing executable: python3" >&2
  exit 1
fi
if [[ ! -f "$SERVER_PROGRAM" ]]; then
  echo "Missing server: $SERVER_PROGRAM" >&2
  exit 1
fi
if [[ "$MODE" != "backend-only" && ! -x "$MENUBAR_PROGRAM" ]]; then
  echo "Missing executable menu bar runner: $MENUBAR_PROGRAM" >&2
  echo "Run: chmod +x $MENUBAR_PROGRAM" >&2
  exit 1
fi

if ! mkdir -p "$LAUNCH_AGENTS_DIR"; then
  echo "Token Meter could not access $HOME/Library/LaunchAgents." >&2
  echo "If a coding agent is running this installer, approve its request for that" >&2
  echo "exact user directory, then retry." >&2
  exit 1
fi

if ! cat > "$SERVER_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$SERVER_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$PYTHON_BIN</string>
    <string>$SERVER_PROGRAM</string>
  </array>
  <key>WorkingDirectory</key>
  <string>$ROOT</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>$ROOT/meter.log</string>
  <key>StandardErrorPath</key>
  <string>$ROOT/meter.err.log</string>
</dict>
</plist>
PLIST
then
  echo "Token Meter could not write $SERVER_PLIST." >&2
  echo "If a coding agent is running this installer, approve its request for that" >&2
  echo "exact user LaunchAgent file, then retry." >&2
  exit 1
fi

if [[ "$MODE" != "backend-only" ]]; then
  if ! cat > "$MENUBAR_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$MENUBAR_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$MENUBAR_PROGRAM</string>
  </array>
  <key>WorkingDirectory</key>
  <string>$ROOT</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>$ROOT/menubar.log</string>
  <key>StandardErrorPath</key>
  <string>$ROOT/menubar.err.log</string>
</dict>
</plist>
PLIST
  then
    echo "Token Meter could not write $MENUBAR_PLIST." >&2
    echo "If a coding agent is running this installer, approve its request for that" >&2
    echo "exact user LaunchAgent file, then retry." >&2
    exit 1
  fi
fi

bootstrap_service() {
  local label="$1" plist="$2" bootstrap_output="" attempt
  for ((attempt = 1; attempt <= 10; attempt++)); do
    if bootstrap_output="$(launchctl bootstrap "gui/$UID" "$plist" 2>&1)"; then
      # A bootout immediately followed by bootstrap can briefly report success
      # before the prior removal finishes. Verify the replacement survives that
      # handoff; otherwise retry the bootstrap instead of leaving the installer
      # waiting on a job that has disappeared.
      sleep 0.5
      if launchctl print "gui/$UID/$label" >/dev/null 2>&1; then
        return 0
      fi
    fi
    if launchctl print "gui/$UID/$label" >/dev/null 2>&1; then
      sleep 0.5
      if launchctl print "gui/$UID/$label" >/dev/null 2>&1; then
        return 0
      fi
    fi
    sleep 0.2
  done
  echo "$bootstrap_output" >&2
  return 1
}

start_server() {
  if ! bootstrap_service "$SERVER_LABEL" "$SERVER_PLIST"; then
    echo "Token Meter could not register its local server." >&2
    echo "If a coding agent is running this installer, approve its request to access" >&2
    echo "$HOME/Library/LaunchAgents and control this user LaunchAgent, then retry." >&2
    return 1
  fi
  launchctl kickstart "gui/$UID/$SERVER_LABEL" >/dev/null 2>&1 || true
  echo "Installed $SERVER_LABEL"
  echo "LaunchAgent: $SERVER_PLIST"
}

start_menubar() {
  if ! bootstrap_service "$MENUBAR_LABEL" "$MENUBAR_PLIST"; then
    echo "Token Meter could not register its menu bar companion." >&2
    echo "If a coding agent is running this installer, approve its request to access" >&2
    echo "$HOME/Library/LaunchAgents and control this user LaunchAgent, then retry." >&2
    return 1
  fi
  launchctl kickstart "gui/$UID/$MENUBAR_LABEL" >/dev/null 2>&1 || true
  echo "Installed $MENUBAR_LABEL"
  echo "LaunchAgent: $MENUBAR_PLIST"
}

case "$MODE" in
  backend-only)
    launchctl bootout "gui/$UID/$MENUBAR_LABEL" >/dev/null 2>&1 || true
    rm -f "$MENUBAR_PLIST"
    launchctl bootout "gui/$UID/$SERVER_LABEL" >/dev/null 2>&1 || true
    start_server
    ;;
  server-only)
    launchctl bootout "gui/$UID/$MENUBAR_LABEL" >/dev/null 2>&1 || true
    launchctl bootout "gui/$UID/$SERVER_LABEL" >/dev/null 2>&1 || true
    start_server
    ;;
  menubar-only)
    launchctl bootout "gui/$UID/$MENUBAR_LABEL" >/dev/null 2>&1 || true
    start_menubar
    ;;
  all)
    launchctl bootout "gui/$UID/$MENUBAR_LABEL" >/dev/null 2>&1 || true
    launchctl bootout "gui/$UID/$SERVER_LABEL" >/dev/null 2>&1 || true
    start_server
    if ! start_menubar; then
      launchctl bootout "gui/$UID/$SERVER_LABEL" >/dev/null 2>&1 || true
      exit 1
    fi
    ;;
esac

echo "Uninstall: $ROOT/scripts/uninstall-launch-agent"
