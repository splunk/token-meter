#!/usr/bin/env bash
set -euo pipefail

SOURCE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BACKEND_ONLY=0

usage() {
  cat <<EOF
Usage: $0 [--backend-only]

Options:
  --backend-only  Install and start only the local server; skip the native companion.
  -h, --help      Show this help.
EOF
}

for argument in "$@"; do
  case "$argument" in
    --backend-only)
      BACKEND_ONLY=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $argument" >&2
      usage >&2
      exit 2
      ;;
  esac
done

PLATFORM="$(uname -s)"
if [[ "$PLATFORM" == "Linux" ]]; then
  exec "$SOURCE_ROOT/scripts/install-linux" "$@"
elif [[ "$PLATFORM" != "Darwin" ]]; then
  echo "Token Meter installation failed: supported platforms are macOS and Linux." >&2
  exit 1
fi
DEFAULT_INSTALL_ROOT="$HOME/Library/Application Support/Token Meter/runtime"
INSTALL_ROOT="${TOKEN_METER_INSTALL_ROOT:-$DEFAULT_INSTALL_ROOT}"
INSTALL_PARENT="$(dirname "$INSTALL_ROOT")"
MANAGED_SOURCE_ROOT="${TOKEN_METER_SOURCE_ROOT:-$INSTALL_PARENT/source}"
MANAGED_SOURCE_ROOT_EXPLICIT="${TOKEN_METER_SOURCE_ROOT:-}"
SERVER_LABEL="com.token-meter.server"
MENUBAR_LABEL="com.token-meter.menubar"
HEALTH_URL="http://127.0.0.1:8722/health"
MENUBAR_URL="http://127.0.0.1:8722/menubar"
DASHBOARD_URL="http://127.0.0.1:8722"
READINESS_TIMEOUT_SECONDS="${TOKEN_METER_READINESS_TIMEOUT_SECONDS:-600}"

fail() {
  echo "Token Meter installation failed: $*" >&2
  exit 1
}

required_commands=(git python3 curl launchctl ditto)
if (( ! BACKEND_ONLY )); then
  required_commands+=(swiftc)
fi
for command_name in "${required_commands[@]}"; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    if [[ "$command_name" == "swiftc" ]]; then
      fail "swiftc is missing. Install the Xcode Command Line Tools, then run this script again."
    fi
    fail "$command_name is required but was not found."
  fi
done

RUNTIME_MANIFEST="$SOURCE_ROOT/runtime-manifest.txt"
[[ -f "$RUNTIME_MANIFEST" ]] \
  || fail "the repository checkout is incomplete: $RUNTIME_MANIFEST is missing."
PYTHONPATH="$SOURCE_ROOT" python3 -m token_meter.packaging manifest "$RUNTIME_MANIFEST" \
  || fail "the runtime packaging manifest is invalid or incomplete."

if [[ ! "$READINESS_TIMEOUT_SECONDS" =~ ^[0-9]+$ || "$READINESS_TIMEOUT_SECONDS" -lt 1 ]]; then
  fail "TOKEN_METER_READINESS_TIMEOUT_SECONDS must be a positive whole number."
fi
mkdir -p "$INSTALL_PARENT"
INSTALL_PARENT="$(cd "$INSTALL_PARENT" && pwd)"
MANAGED_SOURCE_ROOT="${TOKEN_METER_SOURCE_ROOT:-$INSTALL_PARENT/source}"
UPDATE_SOURCE_ROOT="$SOURCE_ROOT"
if [[ "$SOURCE_ROOT" != "$MANAGED_SOURCE_ROOT" ]]; then
  source_upstream="$(git -C "$SOURCE_ROOT" rev-parse \
    --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
  source_remote="${source_upstream%%/*}"
  source_branch="${source_upstream#*/}"
  source_remote_url=""
  if [[ "$source_upstream" == */* ]]; then
    source_remote_url="$(git -C "$SOURCE_ROOT" remote get-url "$source_remote" 2>/dev/null || true)"
  fi
  if [[ -n "$source_remote_url" && -n "$source_branch" ]]; then
    existing_managed_remote_url=""
    if [[ -e "$MANAGED_SOURCE_ROOT" ]]; then
      [[ -d "$MANAGED_SOURCE_ROOT/.git" ]] \
        || fail "the managed update checkout is not a Git repository: $MANAGED_SOURCE_ROOT"
      existing_managed_remote_url="$(git -C "$MANAGED_SOURCE_ROOT" remote get-url origin 2>/dev/null || true)"
      if [[ -n "$existing_managed_remote_url" && "$existing_managed_remote_url" != "$source_remote_url" ]]; then
        if [[ -n "$MANAGED_SOURCE_ROOT_EXPLICIT" ]]; then
          fail "the managed update checkout belongs to a different upstream: $MANAGED_SOURCE_ROOT"
        fi
        source_slug="$(printf '%s' "$source_remote_url" \
          | sed -E 's#^[^:/]+://##; s#^[^@]+@##; s#[:/]+#-#g' \
          | tr -cd '[:alnum:]_.-')"
        source_slug="${source_slug%.git}"
        [[ -n "$source_slug" ]] || source_slug="upstream"
        MANAGED_SOURCE_ROOT="$INSTALL_PARENT/source-$source_slug"
        echo "Preserving the existing managed checkout at:"
        echo "  $INSTALL_PARENT/source"
        echo "Using an upstream-specific managed checkout:"
        echo "  $MANAGED_SOURCE_ROOT"
      fi
    fi
    if [[ ! -e "$MANAGED_SOURCE_ROOT" ]]; then
      git clone --quiet --no-local "$SOURCE_ROOT" "$MANAGED_SOURCE_ROOT" \
        || fail "the managed update checkout could not be created."
    fi
    [[ -d "$MANAGED_SOURCE_ROOT/.git" ]] \
      || fail "the managed update checkout is not a Git repository: $MANAGED_SOURCE_ROOT"
    if [[ -n "$(git -C "$MANAGED_SOURCE_ROOT" status --porcelain 2>/dev/null || true)" ]]; then
      fail "the managed update checkout has local changes: $MANAGED_SOURCE_ROOT"
    fi
    source_revision="$(git -C "$SOURCE_ROOT" rev-parse HEAD 2>/dev/null || true)"
    if [[ -n "$source_revision" ]]; then
      git -C "$MANAGED_SOURCE_ROOT" fetch --quiet --no-tags \
        "$SOURCE_ROOT" "$source_revision" \
        || fail "the managed update checkout could not read the installed revision."
      git -C "$MANAGED_SOURCE_ROOT" merge --quiet --ff-only FETCH_HEAD \
        || fail "the managed update checkout has diverged from the installed source."
    fi
    managed_remote_url="$(git -C "$MANAGED_SOURCE_ROOT" remote get-url origin 2>/dev/null || true)"
    if [[ "$managed_remote_url" != "$source_remote_url" ]]; then
      if [[ "$managed_remote_url" == "$SOURCE_ROOT" ]]; then
        git -C "$MANAGED_SOURCE_ROOT" remote set-url origin "$source_remote_url"
      else
        fail "the managed update checkout belongs to a different upstream: $MANAGED_SOURCE_ROOT"
      fi
    fi
    managed_branch="$(git -C "$MANAGED_SOURCE_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    if [[ -n "$managed_branch" ]]; then
      git -C "$MANAGED_SOURCE_ROOT" config "branch.$managed_branch.remote" origin
      git -C "$MANAGED_SOURCE_ROOT" config \
        "branch.$managed_branch.merge" "refs/heads/$source_branch"
    fi
    UPDATE_SOURCE_ROOT="$MANAGED_SOURCE_ROOT"
  fi
fi

echo "Installing Token Meter from:"
echo "  $SOURCE_ROOT"
echo "Runtime:"
echo "  $INSTALL_ROOT"

mkdir -p "$INSTALL_ROOT"
printf '%s\n' "$UPDATE_SOURCE_ROOT" > "$INSTALL_ROOT/SOURCE_CHECKOUT"
while read -r entry_kind relative_path _; do
  [[ -z "$entry_kind" || "$entry_kind" == \#* ]] && continue
  source_path="$SOURCE_ROOT/$relative_path"
  install_path="$INSTALL_ROOT/$relative_path"
  case "$entry_kind" in
    required|optional)
      [[ -e "$source_path" ]] || [[ "$entry_kind" == "optional" ]] || \
        fail "the required runtime path is missing: $relative_path"
      [[ -e "$source_path" ]] || continue
      mkdir -p "$(dirname "$install_path")"
      ditto "$source_path" "$install_path"
      ;;
    python-tree)
      while IFS= read -r package_file; do
        package_relative="${package_file#"$SOURCE_ROOT/"}"
        mkdir -p "$INSTALL_ROOT/$(dirname "$package_relative")"
        ditto "$package_file" "$INSTALL_ROOT/$package_relative"
      done < <(find "$source_path" -type f -name '*.py' -print | LC_ALL=C sort)
      ;;
    tree)
      mkdir -p "$install_path"
      ditto "$source_path" "$install_path"
      ;;
  esac
done < "$RUNTIME_MANIFEST"
chmod 755 "$INSTALL_ROOT"/scripts/*
PYTHONPATH="$SOURCE_ROOT" python3 -m token_meter.packaging parity \
  "$SOURCE_ROOT" "$INSTALL_ROOT" "$RUNTIME_MANIFEST" \
  || fail "the staged runtime does not match the source manifest."

commit="$(git -C "$SOURCE_ROOT" rev-parse --short HEAD 2>/dev/null || true)"
if [[ -n "$commit" ]]; then
  if [[ -n "$(git -C "$SOURCE_ROOT" status --short 2>/dev/null || true)" ]]; then
    commit="$commit+local"
  fi
  printf '%s\n' "$commit" > "$INSTALL_ROOT/INSTALLED_REVISION"
fi

delivery_bootstrap_json="$(
  cd "$INSTALL_ROOT"
  PYTHONPATH="$INSTALL_ROOT" python3 -c \
    'import json; from token_meter.app import bootstrap_git_delivery; print(json.dumps(bootstrap_git_delivery()))' \
    2>/dev/null || true
)"
if [[ "$delivery_bootstrap_json" == *'"ok": true'* ]]; then
  echo "Indexed available local Git delivery history."
else
  echo "Local Git delivery history will remain partial until a readable repository is observed."
fi

if (( BACKEND_ONLY )); then
  "$INSTALL_ROOT/scripts/install-launch-agent" backend-only
else
  "$INSTALL_ROOT/scripts/install-launch-agent" server-only
fi

health_json=""
readiness_deadline=$((SECONDS + READINESS_TIMEOUT_SECONDS))
while (( SECONDS < readiness_deadline )); do
  health_json="$(curl -fsS --max-time 5 "$HEALTH_URL" 2>/dev/null || true)"
  if [[ "$health_json" == *'"ok": true'* && "$health_json" == *'"state_ready": true'* ]]; then
    break
  fi
  sleep 1
done

if [[ "$health_json" != *'"ok": true'* || "$health_json" != *'"state_ready": true'* ]]; then
  for log in menubar.err.log meter.err.log meter.log; do
    [[ -f "$INSTALL_ROOT/$log" ]] && tail -n 30 "$INSTALL_ROOT/$log" >&2 || true
  done
  fail "the local server did not finish indexing within ${READINESS_TIMEOUT_SECONDS}s at $HEALTH_URL."
fi

if ! server_launch_state="$(launchctl print "gui/$UID/$SERVER_LABEL" 2>&1)"; then
  fail "the local server LaunchAgent was not registered."
fi
[[ "$server_launch_state" == *"$INSTALL_ROOT/meter.py"* ]] \
  || fail "a different Token Meter installation owns the local server LaunchAgent."

printf '%s' "$health_json" | python3 -c '
import json, os, sys
root = os.path.realpath(sys.argv[1])
payload = json.load(sys.stdin)
raw_page = payload.get("page_path")
page = os.path.realpath(raw_page) if raw_page else ""
try:
    matches = bool(page) and os.path.commonpath([root, page]) == root
except ValueError:
    matches = False
if not matches:
    raise SystemExit("Token Meter installation failed: a different server owns port 8722 "
                     f"(page_path={page or 'unknown'}).")
' "$INSTALL_ROOT"

if (( BACKEND_ONLY )); then
  printf '%s\n' "backend-only" > "$INSTALL_ROOT/INSTALL_MODE"
else
  "$INSTALL_ROOT/scripts/install-launch-agent" menubar-only

  if ! menubar_launch_state="$(launchctl print "gui/$UID/$MENUBAR_LABEL" 2>&1)"; then
    fail "the menu bar LaunchAgent was not registered."
  fi
  [[ "$menubar_launch_state" == *"$INSTALL_ROOT/scripts/run-menubar"* ]] \
    || fail "a different Token Meter installation owns the menu bar LaunchAgent."

  curl -fsS --max-time 5 "$MENUBAR_URL" \
    | python3 -c 'import json, sys; json.load(sys.stdin)' \
    || fail "the menu bar endpoint did not return valid JSON."
  printf '%s\n' "full" > "$INSTALL_ROOT/INSTALL_MODE"
fi

echo
echo "Token Meter installation complete."
echo "Dashboard: $DASHBOARD_URL"
echo "Starts automatically after you log in."
(( BACKEND_ONLY )) && echo "Backend-only installation: native companion skipped."
echo "Runtime: $INSTALL_ROOT"
[[ -n "$commit" ]] && echo "Installed commit: $commit"
echo "Uninstall: $INSTALL_ROOT/scripts/uninstall-launch-agent"
